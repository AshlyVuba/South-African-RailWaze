{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://railwaze.geekulcha.co.za/schemas/waypoint.schema.json",
  "title": "WaypointFeatureCollection",
  "description": "Schema defining waypoint features along the Pretoria-to-Cape Town rail corridor.",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id", "geometry", "properties"],
        "properties": {
          "type": {
            "const": "Feature"
          },
          "id": {
            "type": "string",
            "enum": [
              "station-pretoria",
              "station-kimberley",
              "station-matjiesfontein",
              "station-cape-town"
            ],
            "description": "Unique identifier for the anchor station or waypoint."
          },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": {
                "const": "Point"
              },
              "coordinates": {
                "type": "array",
                "prefixItems": [
                  { "type": "number", "minimum": -180, "maximum": 180 },
                  { "type": "number", "minimum": -90, "maximum": 90 }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            },
            "additionalProperties": false
          },
          "properties": {
            "type": "object",
            "required": [
              "id",
              "name",
              "lat",
              "lng",
              "km_mark",
              "elevation_m",
              "biome",
              "memory_vault",
              "audio_capsule_id",
              "memory_vault_id",
              "passport_stamp_id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "station-pretoria",
                  "station-kimberley",
                  "station-matjiesfontein",
                  "station-cape-town"
                ]
              },
              "name": {
                "type": "string",
                "enum": [
                  "Pretoria",
                  "Kimberley",
                  "Matjiesfontein",
                  "Hex River Pass",
                  "Hex River / Cape Town",
                  "Cape Town"
                ]
              },
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lng": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "km_mark": {
                "type": "number",
                "minimum": 0
              },
              "elevation_m": {
                "type": "number",
                "minimum": -500,
                "maximum": 5000
              },
              "biome": {
                "type": "string",
                "enum": ["Highveld", "Diamond Fields", "Great Karoo", "Cape Fynbos"]
              },
              "memory_vault": {
                "type": "string",
                "pattern": "^vault-[a-z0-9-]+$"
              },
              "audio_capsule_id": {
                "type": "string",
                "pattern": "^audio-[a-z0-9-]+$"
              },
              "memory_vault_id": {
                "type": "string",
                "pattern": "^vault-[a-z0-9-]+$"
              },
              "passport_stamp_id": {
                "type": "string",
                "pattern": "^stamp-[a-z0-9-]+$"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}