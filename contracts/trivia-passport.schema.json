{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://railwaze.geekulcha.co.za/schemas/trivia-passport.schema.json",
  "title": "TriviaAndPassport",
  "description": "Schema for waypoint trivia items and user passport progression.",
  "type": "object",
  "definitions": {
    "TriviaQuestion": {
      "type": "object",
      "required": ["id", "waypoint_id", "question", "options", "answer_index", "explanation"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^trivia-[a-z0-9-]+$"
        },
        "waypoint_id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 4,
          "maxItems": 4
        },
        "answer_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "explanation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "TriviaQuestionPublic": {
      "type": "object",
      "required": ["id", "waypoint_id", "question", "options"],
      "properties": {
        "id": { "type": "string", "pattern": "^trivia-[a-z0-9-]+$" },
        "waypoint_id": { "type": "string" },
        "question": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "additionalProperties": false
    },
    "AnswerSubmission": {
      "type": "object",
      "required": ["sessionId", "selectedOptionIndex"],
      "properties": {
        "sessionId": { "type": "string" },
        "selectedOptionIndex": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "StampAward": {
      "type": "object",
      "required": ["stampId", "waypointId", "collectedAt", "waypointName", "badgeIcon", "awardedAt"],
      "properties": {
        "stampId": { "type": "string" },
        "waypointId": { "type": "string" },
        "collectedAt": { "type": "string", "format": "date-time" },
        "waypointName": { "type": "string" },
        "badgeIcon": { "type": "string" },
        "awardedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "AnswerResult": {
      "type": "object",
      "required": ["correct", "correctOptionIndex", "explanation", "stampAwarded"],
      "properties": {
        "correct": { "type": "boolean" },
        "correctOptionIndex": { "type": "integer", "minimum": 0 },
        "explanation": { "type": "string" },
        "stampAwarded": {
          "oneOf": [
            { "$ref": "#/definitions/StampAward" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "TravelerRank": {
      "type": "string",
      "enum": ["Stoker", "Track Master", "Karoo Scout", "Rail Legend"]
    },
    "PassportStamp": {
      "type": "object",
      "required": ["stampId", "waypointId", "collectedAt", "waypointName", "badgeIcon", "awardedAt"],
      "properties": {
        "stampId": { "type": "string" },
        "waypointId": { "type": "string" },
        "collectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "waypointName": { "type": "string" },
        "badgeIcon": { "type": "string" },
        "awardedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "PassportState": {
      "type": "object",
      "required": [
        "sessionId",
        "currentRank",
        "rank",
        "score",
        "totalScore",
        "collectedStamps",
        "stamps",
        "completedTriviaIds",
        "signature"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "format": "uuid"
        },
        "currentRank": {
          "$ref": "#/definitions/TravelerRank"
        },
        "rank": {
          "$ref": "#/definitions/TravelerRank"
        },
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "totalScore": {
          "type": "integer",
          "minimum": 0
        },
        "collectedStamps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PassportStamp"
          }
        },
        "stamps": {
          "type": "array",
          "items": { "$ref": "#/definitions/PassportStamp" }
        },
        "completedTriviaIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signature": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}